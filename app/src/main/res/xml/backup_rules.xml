<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Session tokens, the offline queue and cached data must never be
     restored onto another device, so nothing from app storage is backed up. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
